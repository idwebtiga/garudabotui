{
  "info": {
    "description": "API documentation generated from Zod schemas",
    "title": "Express Base API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "servers": [
    {
      "description": "Local server",
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    },
    "schemas": {
      "AuthUser": {
        "type": "object",
        "properties": {
          "ethAddress": {
            "type": "string"
          },
          "id": {
            "type": "number"
          },
          "isGuest": {
            "type": "boolean"
          },
          "nickname": {
            "type": "string",
            "nullable": true,
            "default": null
          }
        },
        "required": [
          "ethAddress",
          "id",
          "isGuest"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "VerifySignatureBody": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1
          },
          "signature": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "message",
          "signature"
        ]
      },
      "TokenBalance": {
        "type": "object",
        "properties": {
          "formatted": {
            "type": "string"
          },
          "raw": {
            "type": "string"
          }
        },
        "required": [
          "formatted",
          "raw"
        ]
      },
      "UserInfoResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AuthUser"
          },
          {
            "type": "object",
            "properties": {
              "tokenBalance": {
                "$ref": "#/components/schemas/TokenBalance"
              }
            },
            "required": [
              "tokenBalance"
            ]
          }
        ]
      },
      "SendMessageResponse": {
        "type": "object",
        "properties": {
          "reply": {
            "type": "string"
          }
        },
        "required": [
          "reply"
        ]
      },
      "SendMessageBody": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "message"
        ]
      },
      "ChatMessage": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "createdAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ]
          },
          "id": {
            "type": "number"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ]
          },
          "userId": {
            "type": "number"
          }
        },
        "required": [
          "content",
          "id",
          "role",
          "userId"
        ]
      },
      "ChatMessageList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ChatMessage"
        }
      },
      "DocumentResponse": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "createdAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ]
          },
          "id": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "content",
          "createdAt",
          "id",
          "title",
          "updatedAt"
        ]
      },
      "DocumentListResponse": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/DocumentResponse"
        }
      },
      "DocumentFeedItem": {
        "type": "object",
        "properties": {
          "createdAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ]
          },
          "emoji": {
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "number"
          },
          "stance": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string"
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "createdAt",
          "emoji",
          "id",
          "stance",
          "title",
          "updatedAt"
        ]
      },
      "DocumentFeedResponse": {
        "type": "object",
        "properties": {
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentFeedItem"
            }
          },
          "nextCursor": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "documents",
          "nextCursor"
        ]
      },
      "DocumentDetail": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "createdAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ]
          },
          "id": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "content",
          "createdAt",
          "id",
          "title",
          "updatedAt"
        ]
      },
      "SnapshotItem": {
        "type": "object",
        "properties": {
          "ethAddress": {
            "type": "string"
          },
          "formattedBalance": {
            "type": "string"
          },
          "percentage": {
            "type": "number"
          },
          "rawBalance": {
            "type": "string"
          },
          "tier": {
            "type": "number"
          },
          "userId": {
            "type": "number"
          }
        },
        "required": [
          "ethAddress",
          "formattedBalance",
          "percentage",
          "rawBalance",
          "tier",
          "userId"
        ]
      },
      "SnapshotListResponse": {
        "type": "object",
        "properties": {
          "count": {
            "type": "number"
          },
          "snapshots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SnapshotItem"
            }
          },
          "success": {
            "type": "boolean"
          },
          "totalWeight": {
            "type": "string"
          }
        },
        "required": [
          "count",
          "snapshots",
          "success",
          "totalWeight"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/authsiwe/guest": {
      "post": {
        "summary": "Create a guest user",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "Guest user created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/authsiwe/verify": {
      "post": {
        "description": "Verifies an EIP-191 signature of a SIWE message and returns a JWT",
        "summary": "Verify SIWE signature",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifySignatureBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/authsiwe/userinfo": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get current user info",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "User info with token balance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/chat": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Send a chat message",
        "tags": [
          "Chat"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMessageBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AI reply",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendMessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/messages": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get chat history",
        "tags": [
          "Chat"
        ],
        "responses": {
          "200": {
            "description": "Array of chat messages",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatMessageList"
                }
              }
            }
          },
          "400": {
            "description": "Access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/knowledge/documents": {
      "get": {
        "summary": "List all published documents (public)",
        "tags": [
          "Knowledge"
        ],
        "responses": {
          "200": {
            "description": "Array of documents",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentListResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/knowledge/documents/feed": {
      "get": {
        "summary": "Paginated document feed (infinite scroll)",
        "tags": [
          "Knowledge"
        ],
        "responses": {
          "200": {
            "description": "Paginated document feed with stance and emoji",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentFeedResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/knowledge/documents/{id}": {
      "get": {
        "summary": "Get document detail with full content",
        "tags": [
          "Knowledge"
        ],
        "responses": {
          "200": {
            "description": "Document detail with content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/token-snapshot": {
      "get": {
        "summary": "List token snapshots",
        "tags": [
          "Token Snapshots"
        ],
        "responses": {
          "200": {
            "description": "List of snapshots",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotListResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}